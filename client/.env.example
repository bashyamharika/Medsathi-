# ==========================================
# MedSathi Frontend Environment Variables (Vite)
# ==========================================

# Supabase Foundation (PostgreSQL & Auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary Client Configuration (Public only - never expose API secret in client)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Backend API Endpoint
VITE_API_BASE_URL=http://localhost:5000/api
