{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "config/**/*",
    "routes/**/*",
    "controllers/**/*",
    "services/**/*",
    "middleware/**/*",
    "utils/**/*",
    "types/**/*",
    "index.ts",
    "app.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
